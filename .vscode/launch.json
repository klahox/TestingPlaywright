{
    "type": "node",
    "request": "launch",
    "name": "Debug Playwright Test",
    "program": "${workspaceFolder}/node_modules/.bin/playwright",
    "args": ["test", "--project=chromium", "--debug"],
    "console": "integratedTerminal",
    "internalConsoleOptions": "neverOpen",
    "env": {
      "PWDEBUG": "1"
    }
  }